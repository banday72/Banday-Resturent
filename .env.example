DATABASE_URL="postgresql://user:password@localhost:5432/restaurant?schema=public"
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="replace-with-a-long-random-string"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Realtime service (separate long-running host running `npm run start:realtime`)
# The browser connects to NEXT_PUBLIC_REALTIME_URL; Next.js functions POST emits to REALTIME_SERVICE_URL.
# Both the Vercel app and the realtime service must use the same NEXTAUTH_SECRET and REALTIME_SERVICE_KEY.
# Leave these unset when developing with `npm run dev` (realtime is disabled).
# For `npm run dev:realtime`, set NEXT_PUBLIC_REALTIME_URL="http://localhost:3000".
# NEXT_PUBLIC_REALTIME_URL="https://realtime.example.com"
# REALTIME_SERVICE_URL="https://realtime.example.com"
# REALTIME_SERVICE_KEY="replace-with-a-long-random-string"

# Set to "s3" on Vercel - the local filesystem is read-only there.
STORAGE_DRIVER="local"
UPLOAD_DIR="./uploads"
# S3_ENDPOINT=""
# S3_REGION="us-east-1"
# S3_BUCKET=""
# S3_ACCESS_KEY_ID=""
# S3_SECRET_ACCESS_KEY=""

# Optional Stripe payments (otherwise local test provider is used)
# STRIPE_SECRET_KEY=""
# STRIPE_WEBHOOK_SECRET=""

CLERK_SECRET_KEY=""
DEMO_ACCESS_HOURS="12"
